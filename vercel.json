{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/auth/callback",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|auth/callback).*)",
      "destination": "/index.html"
    }
  ]
}
